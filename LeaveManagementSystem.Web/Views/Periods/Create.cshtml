@using LeaveManagementSystem.Application.Models.Periods
@model PeriodCreateViewModel

@{
    ViewData["Title"] = "Define Leave Period";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-primary fw-bold text-decoration-none">Leave Periods</a></li>
                <li class="breadcrumb-item active" aria-current="page">Define New</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0">Define Leave Period</h2>
        <p class="text-muted">Set up a new timeframe for leave allocations (usually annual).</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="glass-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold text-dark">Period Name</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-end-0">
                            <iconify-icon icon="solar:letter-bold-duotone" class="text-primary fw-bold"></iconify-icon>
                        </span>
                        <input asp-for="Name" class="form-control-dash border-start-0" placeholder="e.g. 2025 Calendar Year" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-4">
                    <div class="col-md-6 text-dark fw-bold text-dark">
                        <div class="mb-4">
                            <label asp-for="StartDate" class="form-label fw-bold text-dark">Start Date</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-white border-end-0">
                                    <iconify-icon icon="solar:calendar-bold-duotone" class="text-primary fw-bold"></iconify-icon>
                                </span>
                                <input asp-for="StartDate" type="text" class="form-control-dash border-start-0" placeholder="YYYY-MM-DD" />
                            </div>
                            <span asp-validation-for="StartDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label asp-for="EndDate" class="form-label fw-bold text-dark">End Date</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-white border-end-0">
                                    <iconify-icon icon="solar:calendar-date-bold-duotone" class="text-primary fw-bold"></iconify-icon>
                                </span>
                                <input asp-for="EndDate" type="text" class="form-control-dash border-start-0" placeholder="YYYY-MM-DD" />
                            </div>
                            <span asp-validation-for="EndDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-5">
                    <button type="submit" class="btn-premium flex-grow-1 justify-content-center">
                        <iconify-icon icon="solar:calendar-add-bold-duotone" width="20"></iconify-icon>
                        Initialize Period
                    </button>
                    <a class="btn btn-outline-secondary rounded-3 px-4 d-flex align-items-center" asp-action="Index">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="col-lg-5 d-none d-lg-block">
        <div class="glass-card h-100" style="background: linear-gradient(135deg, rgba(114,9,183,0.05) 0%, rgba(67,97,238,0.05) 100%); border: 1px dashed var(--secondary);">
            <h5 class="fw-bold text-secondary mb-3">Scheduling Guidelines</h5>
            <ul class="list-unstyled text-muted" style="line-height: 1.8;">
                <li class="mb-2 d-flex gap-2">
                    <iconify-icon icon="solar:info-circle-bold-duotone" class="text-secondary mt-1"></iconify-icon>
                    <span>Most organizations operate on a <b>Jan 1st to Dec 31st</b> cycle.</span>
                </li>
                <li class="mb-2 d-flex gap-2">
                    <iconify-icon icon="solar:info-circle-bold-duotone" class="text-secondary mt-1"></iconify-icon>
                    <span>Ensure periods do not overlap with existing defined timeframes.</span>
                </li>
                <li class="mb-2 d-flex gap-2">
                    <iconify-icon icon="solar:shield-up-bold-duotone" class="text-secondary mt-1"></iconify-icon>
                    <span>New employees will be allocated tokens within the currently active period.</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $( function() {
          $( "#StartDate" ).datepicker({
              dateFormat: "yy-mm-dd",
              changeMonth: true,
              changeYear: true,
          });
          $( "#EndDate" ).datepicker({
              dateFormat: "yy-mm-dd",
              changeMonth: true,
              changeYear: true,
          });
        });
    </script>
} 
