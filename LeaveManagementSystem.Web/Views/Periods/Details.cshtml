@using LeaveManagementSystem.Application.Models.Periods
@model PeriodReadOnlyViewModel

@{
    ViewData["Title"] = $"{@Model.Name} Details";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-primary fw-bold text-decoration-none">Leave Periods</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0">Period Specification</h2>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="glass-card">
            <div class="d-flex align-items-center gap-4 mb-5">
                <div class="p-4 rounded-4" style="background: rgba(114, 9, 183, 0.1); color: var(--secondary);">
                    <iconify-icon icon="solar:history-bold-duotone" width="48"></iconify-icon>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-1">@Model.Name</h3>
                    <span class="badge rounded-pill bg-light text-secondary px-3 py-2 fw-bold">Current Cycle</span>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-sm-6">
                    <div class="p-4 rounded-4 bg-light border-start border-4 border-primary">
                        <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Start Date</small>
                        <span class="fs-4 fw-extrabold text-dark">@Model.StartDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-4 rounded-4 bg-light border-start border-4 border-accent">
                        <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">End Date</small>
                        <span class="fs-4 fw-extrabold text-dark">@Model.EndDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mt-5">
                <a class="btn-premium flex-grow-1 justify-content-center" asp-action="Edit" asp-route-id="@Model?.Id">
                    <iconify-icon icon="solar:pen-bold-duotone" width="20"></iconify-icon>
                    Modify Schedule
                </a>
                <a class="btn btn-outline-secondary rounded-3 px-4 d-flex align-items-center" asp-action="Index">
                    Back to List
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-lg-5 d-none d-lg-block">
        <div class="glass-card h-100">
            <h5 class="fw-bold text-dark mb-4 text-center">Cycle Status</h5>
            <div class="text-center py-4">
                <div class="p-5 rounded-circle d-inline-flex mb-4" style="background: rgba(67, 97, 238, 0.05);">
                    <iconify-icon icon="solar:calendar-bold-duotone" width="80" class="text-primary"></iconify-icon>
                </div>
                <p class="text-muted small">This period serves as the container for all leave allocations and request history within its dates.</p>
            </div>
        </div>
    </div>
</div>
