@using LeaveManagementSystem.Application.Models.Periods
@model IEnumerable<PeriodReadOnlyViewModel>

@{
    ViewData["Title"] = "Leave Periods Configuration";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0">Leave Periods</h2>
            <p class="text-muted mb-0">Manage the active and upcoming leave allocation cycles.</p>
        </div>
        <a asp-action="Create" class="btn-premium">
            <iconify-icon icon="solar:calendar-add-bold-duotone" width="20"></iconify-icon>
            Define New Period
        </a>
    </div>
</div>

<div class="glass-card">
    <div class="dash-table-container">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Period Name</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded-3" style="background: rgba(114, 9, 183, 0.1); color: var(--secondary);">
                                <iconify-icon icon="solar:history-bold-duotone" width="24"></iconify-icon>
                            </div>
                            <span class="fw-bold text-dark">@item.Name</span>
                        </div>
                    </td>
                    <td>
                        <span class="text-muted fw-bold">@item.StartDate.ToString("MMM dd, yyyy")</span>
                    </td>
                    <td>
                        <span class="text-muted fw-bold">@item.EndDate.ToString("MMM dd, yyyy")</span>
                    </td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm rounded-3 px-3" type="button" data-bs-toggle="dropdown">
                                <iconify-icon icon="solar:menu-dots-bold" width="18"></iconify-icon>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg p-2" style="border-radius: 12px;">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 rounded-3 py-2" asp-action="Edit" asp-route-id="@item.Id">
                                        <iconify-icon icon="solar:pen-bold-duotone" class="text-primary"></iconify-icon>
                                        Edit
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 rounded-3 py-2" asp-action="Details" asp-route-id="@item.Id">
                                        <iconify-icon icon="solar:eye-bold-duotone" class="text-info"></iconify-icon>
                                        Details
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider opacity-50"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 rounded-3 py-2 text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                        <iconify-icon icon="solar:trash-bin-trash-bold-duotone"></iconify-icon>
                                        Delete
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
