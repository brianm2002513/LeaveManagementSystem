@model LeaveManagementSystem.Application.Models.DashboardVM

@{
    ViewData["Title"] = "Executive Overview";
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="glass-card h-100 border-0" style="background: linear-gradient(135deg, #fff 0%, #f0f4ff 100%);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="stat-icon-wrapper p-3 rounded-4" style="background: rgba(67, 97, 238, 0.1); color: var(--primary);">
                    <iconify-icon icon="solar:folder-open-bold-duotone" width="32"></iconify-icon>
                </div>
            </div>
            <h6 class="text-muted fw-bold mb-1">Total Requests</h6>
            <h2 class="display-6 fw-extrabold mb-0">@Model.TotalRequests</h2>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="glass-card h-100 border-0" style="background: linear-gradient(135deg, #fff 0%, #e6fff7 100%); border-bottom: 4px solid var(--success) !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="stat-icon-wrapper p-3 rounded-4" style="background: rgba(16, 185, 129, 0.1); color: var(--success);">
                    <iconify-icon icon="solar:check-circle-bold-duotone" width="32"></iconify-icon>
                </div>
            </div>
            <h6 class="text-muted fw-bold mb-1">Approved</h6>
            <h2 class="display-6 fw-extrabold mb-0" style="color: var(--success);">@Model.ApprovedRequests</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="glass-card h-100 border-0" style="background: linear-gradient(135deg, #fff 0%, #fff9e6 100%); border-bottom: 4px solid var(--warning) !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="stat-icon-wrapper p-3 rounded-4" style="background: rgba(245, 158, 11, 0.1); color: var(--warning);">
                    <iconify-icon icon="solar:clock-circle-bold-duotone" width="32"></iconify-icon>
                </div>
            </div>
            <h6 class="text-muted fw-bold mb-1">Pending</h6>
            <h2 class="display-6 fw-extrabold mb-0" style="color: var(--warning);">@Model.PendingRequests</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="glass-card h-100 border-0" style="background: linear-gradient(135deg, #fff 0%, #fff0f0 100%); border-bottom: 4px solid var(--danger) !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="stat-icon-wrapper p-3 rounded-4" style="background: rgba(239, 68, 68, 0.1); color: var(--danger);">
                    <iconify-icon icon="solar:danger-circle-bold-duotone" width="32"></iconify-icon>
                </div>
            </div>
            <h6 class="text-muted fw-bold mb-1">Declined</h6>
            <h2 class="display-6 fw-extrabold mb-0" style="color: var(--danger);">@Model.DeclinedRequests</h2>
        </div>
    </div>
</div>

<div class="mt-5">
    <div class="glass-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0 fw-bold">Quick Actions</h4>
        </div>
        <div class="d-flex gap-3 flex-wrap">
            <a asp-controller="LeaveRequests" asp-action="Create" class="btn-premium">
                <iconify-icon icon="solar:add-circle-bold-duotone"></iconify-icon>
                New Leave Request
            </a>
            @if (User.IsInRole("Administrator"))
            {
                <a asp-controller="LeaveRequests" asp-action="ListRequests" class="btn btn-outline-primary rounded-4 px-4 py-2 fw-bold text-decoration-none">
                    Manage Requests
                </a>
                <a asp-controller="LeaveAllocation" asp-action="Index" class="btn btn-outline-primary rounded-4 px-4 py-2 fw-bold text-decoration-none">
                    Employee Directory
                </a>
            }
        </div>
    </div>
</div>
