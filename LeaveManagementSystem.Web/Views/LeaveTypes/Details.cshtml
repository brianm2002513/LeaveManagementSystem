@using LeaveManagementSystem.Application.Models.LeaveTypes
@model LeaveTypeReadOnlyViewModel

@{
    ViewData["Title"] = $"{@Model.Name} Details";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-primary fw-bold text-decoration-none">Leave Types</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0">Leave Category Details</h2>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="glass-card">
            <div class="d-flex align-items-center gap-4 mb-5">
                <div class="p-4 rounded-4" style="background: rgba(67, 97, 238, 0.1); color: var(--primary);">
                    <iconify-icon icon="solar:calendar-bold-duotone" width="48"></iconify-icon>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-1">@Model.Name</h3>
                    <span class="badge rounded-pill bg-light text-primary px-3 py-2 fw-bold">Active Category</span>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-sm-6">
                    <div class="p-3 rounded-4 bg-light">
                        <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Default Allocation</small>
                        <span class="fs-4 fw-extrabold text-dark">@Model.NumberOfDays Days</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-4 bg-light">
                        <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Internal ID</small>
                        <span class="fs-4 fw-extrabold text-dark">#@Model.Id</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mt-5">
                <a class="btn-premium flex-grow-1 justify-content-center" asp-action="Edit" asp-route-id="@Model?.Id">
                    <iconify-icon icon="solar:pen-bold-duotone" width="20"></iconify-icon>
                    Edit Configuration
                </a>
                <a class="btn btn-outline-secondary rounded-3 px-4 d-flex align-items-center" asp-action="Index">
                    Back to List
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-lg-5 d-none d-lg-block">
        <div class="glass-card h-100">
            <h5 class="fw-bold text-dark mb-4">Quick Statistics</h5>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: rgba(16, 185, 129, 0.05);">
                    <div class="d-flex align-items-center gap-2">
                        <iconify-icon icon="solar:user-bold-duotone" class="text-success"></iconify-icon>
                        <span class="text-muted small fw-bold">Allocated Users</span>
                    </div>
                    <span class="fw-extrabold text-dark">--</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: rgba(67, 97, 238, 0.05);">
                    <div class="d-flex align-items-center gap-2">
                        <iconify-icon icon="solar:clipboard-list-bold-duotone" class="text-primary"></iconify-icon>
                        <span class="text-muted small fw-bold">Total Uses</span>
                    </div>
                    <span class="fw-extrabold text-dark">--</span>
                </div>
            </div>
            <p class="text-muted small mt-4">Static data for demonstration. Connect to analytics service for real tracking.</p>
        </div>
    </div>
</div>
