@using LeaveManagementSystem.Application.Models.LeaveTypes
@model LeaveTypeEditViewModel

@{
    ViewData["Title"] = "Edit Leave Type";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-primary fw-bold text-decoration-none">Leave Types</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Configuration</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0">Modify Leave Category</h2>
        <p class="text-muted">Update the settings for <span class="text-primary fw-bold">@Model.Name</span>.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="glass-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold text-dark">Category Name</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-end-0">
                            <iconify-icon icon="solar:tag-bold-duotone" class="text-primary fw-bold"></iconify-icon>
                        </span>
                        <input asp-for="Name" class="form-control-dash border-start-0" placeholder="e.g. Annual Leave, Sick Leave" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NumberOfDays" class="form-label fw-bold text-dark">Default Duration (Days)</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-end-0">
                            <iconify-icon icon="solar:calendar-date-bold-duotone" class="text-primary fw-bold"></iconify-icon>
                        </span>
                        <input asp-for="NumberOfDays" class="form-control-dash border-start-0" placeholder="e.g. 21" />
                    </div>
                    <span asp-validation-for="NumberOfDays" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-3 mt-5">
                    <button type="submit" class="btn-premium flex-grow-1 justify-content-center">
                        <iconify-icon icon="solar:diskette-bold-duotone" width="20"></iconify-icon>
                        Update Category
                    </button>
                    <a class="btn btn-outline-secondary rounded-3 px-4 d-flex align-items-center" asp-action="Index">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5 offset-lg-1 d-none d-lg-block">
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(67,97,238,0.05) 0%, rgba(247,37,133,0.05) 100%); border: 1px dashed var(--primary);">
            <h5 class="fw-bold text-primary mb-3">Important Notice</h5>
            <ul class="list-unstyled text-muted" style="line-height: 1.8;">
                <li class="mb-2 d-flex gap-2">
                    <iconify-icon icon="solar:shield-warning-bold-duotone" class="text-warning mt-1"></iconify-icon>
                    <span>Changing the <b>Default Duration</b> will NOT automatically update existing employee allocations for this current period.</span>
                </li>
                <li class="mb-2 d-flex gap-2">
                    <iconify-icon icon="solar:info-circle-bold-duotone" class="text-primary mt-1"></iconify-icon>
                    <span>Renaming a leave type will update it sitewide across all employee records and reports.</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
