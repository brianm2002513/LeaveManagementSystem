@using LeaveManagementSystem.Application.Models.LeaveTypes
@model LeaveTypeReadOnlyViewModel

@{
    ViewData["Title"] = "Confirm Deletion";
}

<div class="row min-vh-100 align-items-center justify-content-center" style="margin-top: -50px;">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card border-danger border" style="background: rgba(255, 241, 242, 0.7);">
            <div class="text-center mb-4">
                <div class="p-4 rounded-circle d-inline-flex mb-3" style="background: rgba(239, 68, 68, 0.1); color: var(--danger);">
                    <iconify-icon icon="solar:trash-bin-trash-bold-duotone" width="60"></iconify-icon>
                </div>
                <h2 class="fw-bold text-dark">Delete Leave Type?</h2>
                <p class="text-muted">This action is irreversible and may affect existing employee records.</p>
            </div>

            <div class="p-4 rounded-4 bg-white mb-4 border border-danger border-opacity-25">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Category</span>
                    <span class="fw-extrabold text-dark">@Model.Name</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-bold text-uppercase">Default Limit</span>
                    <span class="fw-extrabold text-dark">@Model.NumberOfDays Days</span>
                </div>
            </div>

            <div class="alert alert-warning border-0 rounded-4 d-flex gap-3 mb-5">
                <iconify-icon icon="solar:shield-warning-bold-duotone" class="fs-4"></iconify-icon>
                <div class="small">
                    <b>Warning:</b> Deleting this leave type will remove it from future selection. History for this type may become orphaned.
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex flex-column gap-2">
                    <button type="submit" class="btn btn-danger btn-lg rounded-4 fw-bold py-3">
                        Yes, Delete Permanently
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-lg rounded-4 fw-bold py-3 text-muted">
                        No, Keep This Type
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
