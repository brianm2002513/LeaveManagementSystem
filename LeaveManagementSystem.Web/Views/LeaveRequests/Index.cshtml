@using LeaveManagementSystem.Application.Models.LeaveRequests
@using LeaveManagementSystem.Application.Services.LeaveRequestService
@model IEnumerable<LeaveRequestReadOnlyViewModel>

@{
    ViewData["Title"] = "My Leave History";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0">My Leave History</h2>
            <p class="text-muted mb-0">Track all your submitted leave requests and their current status.</p>
        </div>
        <a asp-action="Create" class="btn-premium">
            <iconify-icon icon="solar:calendar-add-bold-duotone" width="20"></iconify-icon>
            Request Leave
        </a>
    </div>
</div>

<div class="glass-card">
    <div class="dash-table-container">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Leave Type</th>
                    <th>Duration</th>
                    <th>Days</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = "status-pending";
                    if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Approved) statusClass = "status-approved";
                    else if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Declined) statusClass = "status-declined";
                    else if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Cancelled) statusClass = "bg-light text-muted";

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="p-2 rounded-3" style="background: rgba(67, 97, 238, 0.1); color: var(--primary);">
                                    <iconify-icon icon="solar:folder-open-bold-duotone" width="20"></iconify-icon>
                                </div>
                                <span class="fw-bold text-dark">@item.LeaveType</span>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-bold text-dark">
                                @item.StartDate.ToString("MMM dd") - @item.EndDate.ToString("MMM dd, yyyy")
                            </div>
                        </td>
                        <td>
                            <span class="badge rounded-pill bg-light text-primary px-3 py-2 fw-bold">@item.NumberOfDays Days</span>
                        </td>
                        <td>
                            <span class="status-badge @statusClass">@item.LeaveRequestStatus.ToString()</span>
                        </td>
                        <td class="text-end">
                            @if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Pending)
                            {
                                <button data-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-bold cancelBtn">
                                    <iconify-icon icon="solar:trash-bin-minimalistic-bold-duotone" class="me-1"></iconify-icon>
                                    Cancel
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form id="cancelForm" asp-action="Cancel">
    <input type="hidden" name="id" id="leaveRequestId" />
</form>

@section Scripts{
    <script>
        $(function () {
            $('.cancelBtn').click(
                function(e){
                   swal({
                        title: "Are you sure?",
                        text: "You want to withdraw this leave request?",
                        icon: "warning",
                        buttons: {
                            cancel: "Back",
                            confirm: {
                                text: "Yes, Withdraw",
                                className: "btn-danger"
                            }
                        },
                        dangerMode: true,
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data('id');
                            $('#leaveRequestId').val(id);
                            $('#cancelForm').submit();
                        }
                    });
                }); 
        });
    </script>
}
