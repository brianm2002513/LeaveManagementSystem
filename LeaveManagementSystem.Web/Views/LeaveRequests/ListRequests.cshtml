@using LeaveManagementSystem.Application.Models.LeaveRequests
@using LeaveManagementSystem.Application.Services.LeaveRequestService
@model EmployeeLeaveRequestListViewModel
@{
	ViewData["Title"] = "Leave Request Management";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-0">Manage Leave Requests</h2>
        <p class="text-muted mb-0">Review, approve, or decline employee leave submissions.</p>
    </div>
</div>

<!-- Admin Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="glass-card border-0 h-100" style="background: linear-gradient(135deg, #fff 0%, #f0f4ff 100%);">
            <h6 class="text-muted fw-bold mb-1">@Html.DisplayNameFor(model => model.TotalRequests)</h6>
            <h2 class="fw-extrabold mb-0 text-primary">@Model.TotalRequests</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card border-0 h-100" style="background: linear-gradient(135deg, #fff 0%, #e6fff7 100%); border-bottom: 4px solid var(--success) !important;">
            <h6 class="text-muted fw-bold mb-1">@Html.DisplayNameFor(model => model.ApprovedRequests)</h6>
            <h2 class="fw-extrabold mb-0 text-success">@Model.ApprovedRequests</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card border-0 h-100" style="background: linear-gradient(135deg, #fff 0%, #fff9e6 100%); border-bottom: 4px solid var(--warning) !important;">
            <h6 class="text-muted fw-bold mb-1">@Html.DisplayNameFor(model => model.PendingRequests)</h6>
            <h2 class="fw-extrabold mb-0 text-warning">@Model.PendingRequests</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card border-0 h-100" style="background: linear-gradient(135deg, #fff 0%, #fff0f0 100%); border-bottom: 4px solid var(--danger) !important;">
            <h6 class="text-muted fw-bold mb-1">@Html.DisplayNameFor(model => model.DeclinedRequests)</h6>
            <h2 class="fw-extrabold mb-0 text-danger">@Model.DeclinedRequests</h2>
        </div>
    </div>
</div>

@if(Model.LeaveRequests.Count == 0)
{
    <div class="glass-card text-center py-5">
        <div class="p-4 rounded-circle d-inline-flex mb-3" style="background: rgba(67, 97, 238, 0.05);">
            <iconify-icon icon="solar:clipboard-list-bold-duotone" width="60" class="text-primary"></iconify-icon>
        </div>
        <h4 class="fw-bold text-dark">No leave requests found at this time.</h4>
    </div>
}
else
{
    <div class="glass-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0 fw-bold">Recent Submissions</h4>
        </div>

        <div class="dash-table-container">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Type</th>
                        <th>Dates</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LeaveRequests)
                    {
                        var statusClass = "status-pending";
                        if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Approved) statusClass = "status-approved";
                        else if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Declined) statusClass = "status-declined";
                        else if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Cancelled) statusClass = "bg-light text-muted";

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 rounded-circle shadow-sm" style="background: rgba(67, 97, 238, 0.1); color: var(--primary);">
                                        <iconify-icon icon="solar:user-bold-duotone" width="20"></iconify-icon>
                                    </div>
                                    <span class="fw-bold text-dark small">Employee</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-light text-primary px-3 fw-bold">@item.LeaveType</span>
                            </td>
                            <td>
                                <div class="small fw-bold text-dark">
                                    @item.StartDate.ToString("MMM dd") - @item.EndDate.ToString("MMM dd, yyyy")
                                    <br/>
                                    <small class="text-muted">@item.NumberOfDays Days</small>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge @statusClass">@item.LeaveRequestStatus.ToString()</span>
                            </td>
                            <td class="text-end">
                                @if (item.LeaveRequestStatus == LeaveRequestStatusEnum.Pending)
                                {
                                    <a asp-action="Review" asp-route-id=@item.Id class="btn-premium" style="padding: 0.4rem 1rem; font-size: 0.75rem;">
                                        <iconify-icon icon="solar:eye-bold-duotone" class="me-1"></iconify-icon>
                                        Review
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}