@using LeaveManagementSystem.Application.Models.LeaveRequests
@model ReviewLeaveRequestViewModel 
@{
	ViewData["Title"] = "Review Leave Submission";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="ListRequests" class="text-primary fw-bold text-decoration-none">Leave Requests</a></li>
                <li class="breadcrumb-item active" aria-current="page">Review Submission</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0">Review Leave Submission</h2>
        <p class="text-muted">Validate and decide on the proposed leave dates for this employee.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Employee Info Card -->
    <div class="col-lg-4">
        <div class="glass-card mb-4" style="background: linear-gradient(135deg, #fff 0%, #f0f4ff 100%);">
            <div class="text-center mb-4">
                <img src="https://ui-avatars.com/api/?name=@Model.Employee.FirstName+@Model.Employee.LastName&background=4361ee&color=fff&size=100" 
                     class="rounded-circle border border-4 border-white shadow-sm mb-3" />
                <h4 class="fw-bold text-dark mb-1">@Model.Employee.FirstName @Model.Employee.LastName</h4>
                <p class="text-muted small fw-bold mb-0">@Model.Employee.Email</p>
                <span class="badge rounded-pill bg-light text-primary px-3 py-2 fw-bold mt-2">Requesting Identity</span>
            </div>
        </div>
        
        <div class="glass-card bg-white border">
            <h6 class="fw-bold text-dark text-uppercase small mb-3">Decision Management</h6>
            <div class="d-flex flex-column gap-2">
                <button class="btn btn-success btn-lg rounded-4 fw-bold py-3 d-flex align-items-center justify-content-center gap-2 approvalBtn" data-id="@Model.Id" data-approved="true">
                    <iconify-icon icon="solar:check-circle-bold-duotone" fs-4></iconify-icon>
                    Approve Request
                </button>
                <button class="btn btn-danger btn-lg rounded-4 fw-bold py-3 d-flex align-items-center justify-content-center gap-2 approvalBtn" data-id="@Model.Id" data-approved="false">
                    <iconify-icon icon="solar:close-circle-bold-duotone" fs-4></iconify-icon>
                    Decline Request
                </button>
                <a class="btn btn-light btn-lg rounded-4 fw-bold py-3 text-muted" asp-action="ListRequests">
                    Cancel & Return
                </a>
            </div>
        </div>
    </div>

    <!-- Request Details Card -->
    <div class="col-lg-8">
        <div class="glass-card h-100">
            <h4 class="fw-bold text-dark mb-4 border-bottom pb-2">Request Details</h4>
            
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="p-4 rounded-4 bg-light">
                        <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Leave Type</small>
                        <span class="fs-4 fw-extrabold text-dark">@Model.LeaveType</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-4 rounded-4 bg-light">
                        <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Total Days Requested</small>
                        <span class="fs-4 fw-extrabold text-primary">@Model.NumberOfDays Days</span>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted small text-uppercase">Proposed Start</label>
                    <div class="d-flex align-items-center gap-2 fs-5 fw-bold text-dark">
                        <iconify-icon icon="solar:calendar-bold-duotone" class="text-primary"></iconify-icon>
                        @Model.StartDate.ToString("MMMM dd, yyyy")
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted small text-uppercase">Proposed End</label>
                    <div class="d-flex align-items-center gap-2 fs-5 fw-bold text-dark">
                        <iconify-icon icon="solar:calendar-date-bold-duotone" class="text-accent"></iconify-icon>
                        @Model.EndDate.ToString("MMMM dd, yyyy")
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-2">Employee Comments</h6>
                <div class="p-4 rounded-4 bg-light italic text-muted border-start border-4 border-primary">
                    "@(string.IsNullOrWhiteSpace(Model.RequestComments) ? "No comments provided by employee." : Model.RequestComments)"
                </div>
            </div>
        </div>
    </div>
</div>

<form asp-action="Review" id="approvalForm">
	<input type="hidden" name="id" id="leaveRequestId" />
    <input type="hidden" name="approved" id="approved" />
</form>

@section Scripts {
    <script>
        $(function () {
            $('.approvalBtn').click(
                function(e){
                   var approved = $(this).data('approved');
                   var actionText = approved ? "approve" : "decline";
                   var iconType = approved ? "success" : "error";

                   swal({
                        title: "Confirm Decision?",
                        text: "Are you sure you want to " + actionText + " this leave request?",
                        icon: "warning",
                        buttons: {
                            cancel: "Back",
                            confirm: {
                                text: approved ? "Yes, Approve" : "Yes, Decline",
                                className: approved ? "btn-success" : "btn-danger"
                            }
                        },
                        dangerMode: !approved,
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data('id');
                            $('#leaveRequestId').val(id);
							$('#approved').val(approved);
                            $('#approvalForm').submit();
                        }
                    });
                }
            );
        });
    </script>
}