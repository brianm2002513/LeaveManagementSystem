@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    string firstRole = null;
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            var roles = await UserManager.GetRolesAsync(user);
            firstRole = roles.FirstOrDefault();
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Leave Management System</title>
    <link rel="shortcut icon" type="image/png" href="~/images/logos/leave.png" />
    
    <!-- Core UI -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/jqueryui/themes/base/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/css/dashboard-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LeaveManagementSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="dash-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="dash-sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">LM</div>
                <h4 class="mb-0 fw-bold">LeaveMS</h4>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-label">Main</div>
                    <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                       asp-area="" asp-controller="Home" asp-action="Index">
                        <iconify-icon icon="solar:home-2-bold-duotone"></iconify-icon>
                        <span>Dashboard</span>
                    </a>
                </div>

                @if (User.IsInRole("Administrator"))
                {
                    <div class="nav-section">
                        <div class="nav-label">Management</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LeaveTypes" ? "active" : "")" 
                           asp-area="" asp-controller="LeaveTypes" asp-action="Index">
                            <iconify-icon icon="solar:calendar-mark-bold-duotone"></iconify-icon>
                            <span>Leave Types</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Periods" ? "active" : "")" 
                           asp-area="" asp-controller="Periods" asp-action="Index">
                            <iconify-icon icon="solar:history-bold-duotone"></iconify-icon>
                            <span>Periods</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LeaveAllocation" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                           asp-area="" asp-controller="LeaveAllocation" asp-action="Index">
                            <iconify-icon icon="solar:users-group-rounded-bold-duotone"></iconify-icon>
                            <span>Employees</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LeaveRequests" && ViewContext.RouteData.Values["Action"]?.ToString() == "ListRequests" ? "active" : "")" 
                           asp-area="" asp-controller="LeaveRequests" asp-action="ListRequests">
                            <iconify-icon icon="solar:clipboard-check-bold-duotone"></iconify-icon>
                            <span>Manage Requests</span>
                        </a>
                    </div>
                }

                <div class="nav-section">
                    <div class="nav-label">Personal</div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LeaveAllocation" && ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "active" : "")" 
                           asp-area="" asp-controller="LeaveAllocation" asp-action="Details">
                            <iconify-icon icon="solar:wallet-2-bold-duotone"></iconify-icon>
                            <span>My Allocations</span>
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LeaveRequests" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                           asp-area="" asp-controller="LeaveRequests" asp-action="Index">
                            <iconify-icon icon="solar:notes-bold-duotone"></iconify-icon>
                            <span>My Requests</span>
                        </a>
                    }
                    else
                    {
                        <a class="nav-item" asp-area="Identity" asp-page="/Account/Login">
                            <iconify-icon icon="solar:login-bold-duotone"></iconify-icon>
                            <span>Login</span>
                        </a>
                        <a class="nav-item" asp-area="Identity" asp-page="/Account/Register">
                            <iconify-icon icon="solar:user-plus-bold-duotone"></iconify-icon>
                            <span>Register</span>
                        </a>
                    }
                </div>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="dash-content">
            <header class="dash-header">
                <div class="header-left d-flex align-items-center gap-3">
                    <button class="btn d-lg-none p-0" id="mobile-toggle">
                        <iconify-icon icon="solar:menu-dots-bold" fs-4></iconify-icon>
                    </button>
                    <div class="header-title">
                        <h1 class="mb-0">@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="header-right">
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/lib/jqueryui/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    <script>
        $(document).ready(function() {
            // Mobile toggle logic
            $('#mobile-toggle').on('click', function() {
                $('#sidebar').toggleClass('open');
            });

            // Close sidebar when clicking outside on mobile
            $(document).on('mousedown', function(e) {
                var sidebar = $("#sidebar");
                if (!sidebar.is(e.target) && sidebar.has(e.target).length === 0 && sidebar.hasClass('open')) {
                    sidebar.removeClass('open');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>