@using LeaveManagementSystem.Application.Models.LeaveAllocations
@model LeaveAllocationEditViewModel

@{
	ViewData["Title"] = "Update Allocation";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-primary fw-bold text-decoration-none">Employees</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-userId="@Model.Employee.Id" class="text-primary fw-bold text-decoration-none">Allocations</a></li>
                <li class="breadcrumb-item active" aria-current="page">Update</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0">Update @Model.LeaveType?.Name Allocation</h2>
        <p class="text-muted">Adjusting balance for <span class="text-primary fw-bold">@Model.Employee.FirstName @Model.Employee.LastName</span>.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="glass-card">
            <form asp-action="EditAllocation">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="LeaveType.Id" />
                <input type="hidden" asp-for="Employee.Id" />
                
                <div class="mb-4">
                    <label asp-for="NumberOfDays" class="form-label fw-bold text-dark">Number of Days Allocated</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-end-0">
                            <iconify-icon icon="solar:calendar-date-bold-duotone" class="text-primary fw-bold"></iconify-icon>
                        </span>
                        <input asp-for="NumberOfDays" class="form-control-dash border-start-0" placeholder="e.g. 21" />
                    </div>
                    <span asp-validation-for="NumberOfDays" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-3 mt-5">
                    <button type="submit" class="btn-premium flex-grow-1 justify-content-center">
                        <iconify-icon icon="solar:diskette-bold-duotone" width="20"></iconify-icon>
                        Save Adjustments
                    </button>
                    <a class="btn btn-outline-secondary rounded-3 px-4 d-flex align-items-center" asp-action="Details" asp-route-userId="@Model.Employee.Id">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5 offset-lg-1 d-none d-lg-block">
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(67,97,238,0.05) 0%, rgba(247,37,133,0.05) 100%); border: 1px dashed var(--primary);">
            <h5 class="fw-bold text-primary mb-3">Allocation Note</h5>
            <p class="text-muted small" style="line-height: 1.6;">
                Manual adjustments to allocations are typically used for special grants or corrections. 
                Ensure that any increase or decrease is documented according to company HR policy.
            </p>
            <div class="mt-3 p-3 rounded-4 bg-white border">
                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted fw-bold text-uppercase" style="font-size: 0.6rem;">Leave Type</small>
                    <span class="text-dark fw-bold small">@Model.LeaveType?.Name</span>
                </div>
                <div class="d-flex justify-content-between">
                    <small class="text-muted fw-bold text-uppercase" style="font-size: 0.6rem;">Employee</small>
                    <span class="text-dark fw-bold small">@Model.Employee.FirstName @Model.Employee.LastName</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
