@model IEnumerable<EmployeeListViewModel>

@{
    ViewData["Title"] = "Employee Directory";
}

<div class="row mb-4">
    <div class="col-12 text-dark">
        <h2 class="fw-bold mb-0">Employee Directory</h2>
        <p class="text-muted mb-0">Overview of all active personnel and their leave statuses.</p>
    </div>
</div>

<div class="glass-card">
    <div class="dash-table-container">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Email Address</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <img src="https://ui-avatars.com/api/?name=@item.FirstName+@item.LastName&background=4361ee&color=fff" 
                                 class="user-avatar" style="width: 40px; height: 40px;" />
                            <div>
                                <span class="fw-bold text-dark d-block">@item.FirstName @item.LastName</span>
                                <small class="text-muted" style="font-size: 0.7rem;">Team Member</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="text-muted fw-500">@item.Email</span>
                    </td>
                    <td class="text-end">
                        <a class="btn-premium" style="padding: 0.5rem 1rem; font-size: 0.8rem;" asp-action="Details" asp-route-userId="@item.Id">
                            <iconify-icon icon="solar:eye-bold-duotone" width="18"></iconify-icon>
                            View Allocations
                        </a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>